{
  "name": "@offwise/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @offwise/shared build && nest build",
    "start": "node dist/main.js",
    "start:dev": "pnpm --filter @offwise/shared build && nest start --watch",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @offwise/shared build && tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@offwise/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@swc/core": "^1.16.18",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
