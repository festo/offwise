# Copy to apps/api/.env for local development. Every variable is validated at startup.
NODE_ENV=development
PORT=3000
# error | warn | info | debug
LOG_LEVEL=debug
DATABASE_URL=postgresql://offwise:offwise@localhost:5432/offwise
PUBLIC_URL=http://localhost:5173
# Reverse proxies allowed to set X-Forwarded-For (used for per-IP login throttling):
# true | false | a hop count | comma-separated IPs, CIDRs or loopback/linklocal/uniquelocal. Default: loopback
TRUST_PROXY=loopback
REDIS_URL=redis://localhost:6379/0
# Dev-only placeholder (at least 32 characters). Change it for any shared or real deployment
# (rejected when NODE_ENV=production).
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# Session lifetime in whole days (1-365): sliding idle timeout, and absolute cap since sign-in.
SESSION_IDLE_TIMEOUT_DAYS=7
SESSION_MAX_AGE_DAYS=30
# Dev-only placeholder: change me for any shared or real deployment (rejected when NODE_ENV=production).
# base64 for exactly 32 bytes: openssl rand -base64 32
ENCRYPTION_KEY=ndZMmk9iiQkenJrFGsco5APAgWMwGmejXgnikmxKPU8=
# Mailpit (docker compose up -d mailpit): SMTP on 1025, web UI on http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=offwise <noreply@offwise.local>
# Optional first admin, created by the install command
INITIAL_ADMIN_EMAIL=admin@offwise.local
INITIAL_ADMIN_PASSWORD=offwise-admin-dev
